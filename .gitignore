# ==============================================================================
# Marine Debris Detector - SIH26057 Prototype
# Comprehensive Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Environment & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/
myenv/

# Python Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 2. Node.js & Vite Frontend
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
*/node_modules/

# Production build outputs
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# Vite local caches
.vite/
frontend/.vite/
*/.vite/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files
.env.local
.env.*.local
frontend/.env.local
frontend/.env.*.local

# ------------------------------------------------------------------------------
# 3. Machine Learning, Deep Learning (YOLO11 / PyTorch) & Caches
# ------------------------------------------------------------------------------
# Ultralytics dataset label caches (generated dynamically)
*.cache
*.pt.cache
labels/*.cache
labels/**/*.cache
*/labels/*.cache
*/labels/**/*.cache

# Training runs, validation outputs, and logs
runs/
runs_sonar/
training/runs/
wandb/
.neptune/
mlruns/
lightning_logs/
checkpoints/

# Aggregated / Large generated datasets
dataset_unified/

# Explicit model weights policy:
# Track production fine-tuned weights, ignore temporary checkpoints or extra exports
# Keep weights/ directory and production YOLO11 models
!weights/
!weights/yolo11_seg_best.pt
!weights/training_metrics.json

# ------------------------------------------------------------------------------
# 4. Secrets, Credentials & Local Configurations
# ------------------------------------------------------------------------------
.env
backend/.env
*.pem
*.key
*.cert
*.crt
credentials.json
service_account.json
secrets.yaml

# ------------------------------------------------------------------------------
# 5. Operating System & Filesystem Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 6. IDEs & Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. Temporary, Scratch & Log Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.swp
.cache/
tmp/
temp/
